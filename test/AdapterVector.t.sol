pragma solidity 0.8.26;

import {TaskGateFixture} from "./utils/TaskGateFixture.sol";
import {TaskGateHook} from "../src/TaskGateHook.sol";
import {TaskBindingLib} from "../src/TaskBindingLib.sol";
import {IHooks} from "v4-core/src/interfaces/IHooks.sol";
import {Currency} from "v4-core/src/types/Currency.sol";
import {PoolKey} from "v4-core/src/types/PoolKey.sol";
import {PoolId, PoolIdLibrary} from "v4-core/src/types/PoolId.sol";

/// @notice Cross-language check: the JS adapter's PoolId, EIP-712 digest, signature and hookData bytes
///         (test/fixtures/adapter-vector.json, generated by `npm run vector`) are accepted by the Solidity hook.
contract AdapterVectorTest is TaskGateFixture {
    using PoolIdLibrary for PoolKey;

    string internal json;
    TaskBindingLib.TaskBinding internal vb;
    PoolKey internal vkey;
    bytes internal vsig;

    function setUp() public override {
        super.setUp();
        json = vm.readFile("test/fixtures/adapter-vector.json");
        vkey = PoolKey(
            Currency.wrap(vm.parseJsonAddress(json, ".poolKey.currency0")),
            Currency.wrap(vm.parseJsonAddress(json, ".poolKey.currency1")),
            uint24(vm.parseJsonUint(json, ".poolKey.fee")),
            int24(int256(vm.parseJsonUint(json, ".poolKey.tickSpacing"))),
            IHooks(vm.parseJsonAddress(json, ".poolKey.hooks"))
        );
        vb = TaskBindingLib.TaskBinding({
            taskId: vm.parseJsonBytes32(json, ".binding.taskId"),
            statusHash: vm.parseJsonBytes32(json, ".binding.statusHash"),
            evidenceHash: vm.parseJsonBytes32(json, ".binding.evidenceHash"),
            poolId: vm.parseJsonBytes32(json, ".binding.poolId"),
            actor: vm.parseJsonAddress(json, ".binding.actor"),
            actions: uint8(vm.parseJsonUint(json, ".binding.actions")),
            maxUses: uint32(vm.parseJsonUint(json, ".binding.maxUses")),
            observedAt: uint64(vm.parseUint(vm.parseJsonString(json, ".binding.observedAt"))),
            expiry: uint64(vm.parseUint(vm.parseJsonString(json, ".binding.expiry"))),
            epoch: uint64(vm.parseUint(vm.parseJsonString(json, ".binding.epoch"))),
            chainId: uint64(vm.parseUint(vm.parseJsonString(json, ".binding.chainId"))),
            hook: vm.parseJsonAddress(json, ".binding.hook"),
            nonce: vm.parseUint(vm.parseJsonString(json, ".binding.nonce"))
        });
        vsig = vm.parseJsonBytes(json, ".signature");
        vm.prank(owner);
        hook.configurePool(vkey, true, BOTH, COMPLETED, bytes32(0), MAX_STALENESS, MAX_TTL);
        vm.warp(vb.observedAt + 5);
    }

    function test_vector_poolIdMatchesV4() public view {
        assertEq(PoolId.unwrap(vkey.toId()), vm.parseJsonBytes32(json, ".poolId"));
        assertEq(vb.poolId, PoolId.unwrap(vkey.toId()));
    }

    function test_vector_digestAndSignerMatch() public view {
        assertEq(hook.hashBinding(vb), vm.parseJsonBytes32(json, ".digest"));
        assertEq(vm.parseJsonAddress(json, ".signer"), adapter, "fixture signer is the fixture adapter key");
        (TaskGateHook.Reason r, address signer) = hook.previewBinding(vb, vsig);
        assertEq(uint8(r), uint8(TaskGateHook.Reason.OK));
        assertEq(signer, adapter);
    }

    function test_vector_hookDataBytesIdentical_andAcceptedInline() public view {
        bytes memory jsHookData = vm.parseJsonBytes(json, ".hookData");
        assertEq(jsHookData, abi.encode(vb, vsig));
        assertEq(jsHookData.length, hook.HOOKDATA_LENGTH());
        assertEq(uint8(hook.previewCallback(vkey, vb.actor, SWAP, jsHookData)), uint8(TaskGateHook.Reason.OK));
        assertEq(uint8(hook.previewCallback(vkey, vb.actor, ADD, jsHookData)), uint8(TaskGateHook.Reason.OK));
    }

    function test_vector_submitInstallsGrant() public {
        assertEq(uint8(hook.submitBinding(vb, vsig)), uint8(TaskGateHook.Reason.OK));
        assertEq(hook.grantOf(vkey.toId(), vb.actor).usesLeft, 2);
        assertEq(hook.grantOf(vkey.toId(), vb.actor).evidenceHash, vb.evidenceHash);
    }
}
